{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "APITechCurse": "",
    "RedisCache": ""
  },
  "Jwt": {
    "Issuer": "",
    "Audience": "",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Swagger": {
    "Enabled": false
  },
  "Payments": {
    "Enabled": false
  },
  "ForwardedHeaders": {
    "KnownProxies": "",
    "KnownNetworks": ""
  },
  "Cors": {
    "AllowedOrigins": ""
  },
  "RateLimiting": {
    "Enabled": true,
    "GlobalPermitLimit": 200,
    "GlobalWindowSeconds": 60,
    "AuthPermitLimit": 10,
    "AuthWindowSeconds": 60
  }
}
