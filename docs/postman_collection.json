{
  "info": {
    "name": "Tech Curse API",
    "description": "Collection da Tech Curse API v2.0.0.\n\nAutenticacao: rode Auth > Login. O script de teste grava accessToken e refreshToken nas variaveis da collection, e as demais requisicoes usam o accessToken automaticamente via Bearer.\n\nO baseUrl padrão, http://localhost:5130, corresponde ao \"dotnet run\"; ajuste conforme o ambiente.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "a18d56df-42b3-4881-8698-dbfa4aefbb25"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "description": "Rate limit proprio: 10 requisicoes por minuto por IP. Excedido, devolve 429 com Retry-After.",
      "item": [
        {
          "name": "Registrar",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/tech-curse/Auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tech-curse",
                "Auth",
                "register"
              ]
            },
            "description": "Cria sempre um Student; o role enviado no corpo é ignorado.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"AlunoExemplo\",\n  \"email\": \"aluno@techcurse.com\",\n  \"password\": \"SenhaForte1!\",\n  \"confirmPassword\": \"SenhaForte1!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const corpo = pm.response.json();",
                  "if (corpo.accessToken) {",
                  "    pm.collectionVariables.set(\"accessToken\", corpo.accessToken);",
                  "}",
                  "if (corpo.refreshToken) {",
                  "    pm.collectionVariables.set(\"refreshToken\", corpo.refreshToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Criar usuário (Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/tech-curse/Auth/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tech-curse",
                "Auth",
                "users"
              ]
            },
            "description": "Admin. Cria usuário com a role informada (Admin, Instructor ou Student). Requer token de Admin: faça login com o Admin semeado em Development.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"InstrutorExemplo\",\n  \"email\": \"instrutor@techcurse.com\",\n  \"role\": \"Instructor\",\n  \"password\": \"SenhaForte1!\",\n  \"confirmPassword\": \"SenhaForte1!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/tech-curse/Auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tech-curse",
                "Auth",
                "login"
              ]
            },
            "description": "Grava accessToken e refreshToken nas variaveis da collection.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"aluno@techcurse.com\",\n  \"password\": \"SenhaForte1!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const corpo = pm.response.json();",
                  "if (corpo.accessToken) {",
                  "    pm.collectionVariables.set(\"accessToken\", corpo.accessToken);",
                  "}",
                  "if (corpo.refreshToken) {",
                  "    pm.collectionVariables.set(\"refreshToken\", corpo.refreshToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/tech-curse/Auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tech-curse",
                "Auth",
                "refresh"
              ]
            },
            "description": "O refresh token e rotacionado a cada uso e vale 7 dias.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accessToken\": \"{{accessToken}}\",\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const corpo = pm.response.json();",
                  "if (corpo.accessToken) {",
                  "    pm.collectionVariables.set(\"accessToken\", corpo.accessToken);",
                  "}",
                  "if (corpo.refreshToken) {",
                  "    pm.collectionVariables.set(\"refreshToken\", corpo.refreshToken);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
